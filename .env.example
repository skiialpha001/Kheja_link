# Supabase — Project Settings > API
# Safe to expose to the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical site URL. Used for auth email redirects, sitemap and OG tags.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (server-only — never NEXT_PUBLIC_)
# Paystack secret key. Required in production; missing configuration fails closed.
PAYSTACK_SECRET_KEY=
# Needed by the payment webhook to confirm an unlock. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Required to authenticate /api/cron/daily when this endpoint is deployed.
# Configure the same random value in Vercel and any GitHub Actions caller.
CRON_SECRET=replace-with-a-random-secret
